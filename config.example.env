# Logic Linux — safe configuration template (environment variables)
# Copy this file as .env or integration secrets and fill real values.
# Do NOT commit actual secrets.

# MySQL connection (external database, see docs/DATABASE.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=cashin
DB_CHARSET=utf8mb4

# Monitoring server (see WIKI-LLM/docs/MONITORING.md)
MONITOR_HOST=<MONITORING_SERVER>
MONITOR_PORT=333

# Payment server (see WIKI-LLM/docs/PAYMENT.md)
PAYMENT_URI=http://<PAYMENT_SERVER>:14111